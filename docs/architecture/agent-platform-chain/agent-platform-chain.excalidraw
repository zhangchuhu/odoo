    {
      "id": "e0052",
      "type": "text",
      "x": 105,
      "y": 1135,
      "width": 572.0799999999999,
      "height": 259.20000000000005,
      "angle": 0,
      "strokeColor": "#343434",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
