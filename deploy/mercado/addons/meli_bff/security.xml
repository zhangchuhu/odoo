<odoo>
  <record id="group_reader" model="res.groups">
    <field name="name">Mercado Libre BFF Reader</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_writer" model="res.groups">
    <field name="name">Mercado Libre BFF Writer</field>
    <field name="implied_ids" eval="[(4, ref('group_reader'))]"/>
  </record>
  <record id="meli_oerp.group_mercadolibre_manager" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_writer'))]"/>
  </record>
  <record id="access_store_reader" model="ir.model.access">
    <field name="name">BFF store metadata reader</field>
    <field name="model_id" ref="meli_accounts.model_meli_independent_store"/>
    <field name="group_id" ref="group_reader"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
