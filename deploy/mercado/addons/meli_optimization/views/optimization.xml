<odoo>
  <record id="task_list" model="ir.ui.view"><field name="name">Optimization tasks</field><field name="model">meli.optimization.task</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="case_id"/><field name="task_type"/><field name="state"/><field name="lease_epoch"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="task_form" model="ir.ui.view"><field name="name">Optimization task</field><field name="model">meli.optimization.task</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="case_id"/><field name="snapshot_id"/><field name="task_type"/><field name="state"/><field name="lease_epoch"/><field name="lease_expires_at"/></group><field name="payload"/><field name="result"/></sheet></form></field></record>
  <record id="tasks_action" model="ir.actions.act_window"><field name="name">Optimization tasks</field><field name="res_model">meli.optimization.task</field><field name="view_mode">list,form</field></record>
  <menuitem id="optimization_menu" name="Optimization" groups="group_editor,group_worker"/>
  <record id="workbench_action" model="ir.actions.client"><field name="name">运营工作台</field><field name="tag">meli_optimization.workbench</field></record>
  <menuitem id="optimization_workbench" name="运营工作台" parent="optimization_menu" action="workbench_action" sequence="1"/>
  <menuitem id="optimization_tasks" name="Tasks" parent="optimization_menu" action="tasks_action"/>
</odoo>
