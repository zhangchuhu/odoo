{
  "mcp": {
    "servers": {
      "odoo_bff": {
        "transport": "stdio",
        "command": "/absolute/path/odoo/python/.venv/bin/python",
        "args": ["-m", "odoo_bff_mcp", "--env-file", "/absolute/path/odoo/python/.env"],
        "enabled": true,
        "connectionTimeoutMs": 15000,
        "requestTimeoutMs": 210000
      }
    }
  }
}
