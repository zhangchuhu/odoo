# Odoo root URL, without /api/meli. Use the actual Odoo deployment hostname.
ODOO_BFF_BASE_URL=https://erp.example.com
# Odoo API Key of an internal user with BFF Reader/Writer permission.
ODOO_BFF_API_KEY=replace-with-your-odoo-api-key
# Includes BFF authorization/ownership lookups and upstream execution.
ODOO_BFF_TIMEOUT_SECONDS=180
# May be lowered, but cannot exceed the BFF's 10 MB image limit.
MAX_UPLOAD_BYTES=10000000
